# Copy to /opt/zovive/.env on the node (systemd loads it via
# EnvironmentFile=) and fill in. .env is git-ignored: secrets live ONLY
# there, never in configs/*.yaml, which reference them as ${VAR}.
# Protect it:  sudo chown root:zovive .env && sudo chmod 640 .env
# For local runs, export the same variables in your shell.

# Camera address. Optional: when unset, configs/rtsp_config.yaml and
# configs/camera.yaml use the deployment default 192.168.1.250. Uncomment
# only for a camera at another address. If set, it must be a bare IPv4
# address or hostname: an empty value does NOT fall back to the default,
# and empty, IPv6, URL or host:port values stop edge_main.py with a
# configuration error (exit 78). The effective host and its source are
# logged at startup ("camera host").
# ZOVIVE_CAMERA_HOST=192.168.1.250

# REQUIRED: edge_main.py and tools/camera_probe.py refuse to start if any
# of these is unset or empty. RTSP stream login:
ZOVIVE_CAMERA_USERNAME=
ZOVIVE_CAMERA_PASSWORD=
# ONVIF (zoom/focus/snapshot) login; may be the same account as RTSP.
ZOVIVE_ONVIF_USERNAME=
ZOVIVE_ONVIF_PASSWORD=

ZOVIVE_BASE_STATION_URL=
# Optional; sent as the base station API key (configs/transfer_config.yaml).
ZOVIVE_BASE_STATION_API_KEY=

# Overrides paths.DATA_ROOT (db, snapshots, logs). Point this at the
# USB SSD mount point on the Pi.
ZOVIVE_HOME=/var/lib/zovive

# --- Phase 1 foundation (utils/config_loader.py, utils/logger.py) ---------
# Read by configs/*.yaml via ${VAR:-default} interpolation.
# Unique per node (e.g. Node-001): the permanent identity the base station
# sees, read by configs/node_config.yaml. See network/node_identity.py.
ZOVIVE_NODE_ID=zovive-node-01
ZOVIVE_BASE_STATION_IP=192.168.1.110
ZOVIVE_BASE_STATION_PORT=8000
# onnx | hailo
ZOVIVE_INFERENCE_BACKEND=onnx
# Optional overrides (defaults: <project>/configs, <project>/logs, INFO, edge.log)
ZOVIVE_CONFIG_DIR=
ZOVIVE_LOG_DIR=
ZOVIVE_LOG_LEVEL=
ZOVIVE_LOG_FILE=
