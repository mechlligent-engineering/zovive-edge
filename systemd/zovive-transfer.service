[Unit]
Description=ZOVIVE evidence transfer and retention
After=network-online.target var-lib-zovive.mount data.mount

[Service]
Type=simple
User=zovive
WorkingDirectory=/opt/zovive
EnvironmentFile=/opt/zovive/.env
ExecStart=/opt/zovive/.venv/bin/python transfer_main.py
Restart=always
RestartSec=5
IOSchedulingClass=idle
Nice=10

[Install]
WantedBy=multi-user.target
